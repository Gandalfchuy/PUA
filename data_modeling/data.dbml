Ref: sectorsocial.deleted_by > usuarios.id

Ref: actividadrecreativa.created_by > usuarios.id
Ref: actividadrecreativa.updated_by > usuarios.id
Ref: actividadrecreativa.deleted_by > usuarios.id

Ref: generomusical.created_by > usuarios.id
Ref: generomusical.updated_by > usuarios.id
Ref: generomusical.deleted_by > usuarios.id

