  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

Table agresor_relacionpadre {
  agresor_folio int [pk]
  tipo_relacion_id int [pk]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

Table agresor_relacionmadre {
  agresor_folio int [pk]
  tipo_relacion_id int [pk]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

Table agresor_relacionhermanos {
  agresor_folio int [pk]
  tipo_relacion_id int [pk]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

Table agresor_sectorsocial {
  agresor_folio int [pk]
  sector_social_id int [pk]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

Table agresor_actividadrecreativa {
  agresor_folio int [pk]
  actividad_id int [pk]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

Table agresor_generomusical {
  agresor_folio int [pk]
  genero_id int [pk]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

// ==========================================
// 5. TABLAS DE PROCESO DE REEDUCACIÓN
// ==========================================

Table procesoreeducacion {
  folio serial [pk]
  agresor_id int [not null]
  fecha_inicio timestamp [not null]
  fecha_termino timestamp
  fecha_denuncia timestamp
  denunciante varchar [not null]
  folio_carpeta_fiscalia varchar [not null]
  
  motivo_ingreso_id int
  tipo_violencia_id int
  modalidad_violencia_id int
  
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

Table grupo {
  folio serial [pk]
  ubicacion geography
  lugar varchar [not null]
  
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

Table sesion {
  folio serial [pk]
  nombre varchar [not null]
  objetivo text [not null]
  
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

Table lista {
  id serial [pk]
  agresor_id int [not null]
  grupo_id int [not null]
  sesion_id int [not null]
  
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}
// ==========================================
// 6. GESTIÓN DE ACCESO (Usuarios y Roles)
// ==========================================

Table roles {
  id serial [pk]
  nombre varchar [unique, not null] // Ej: 'Superadmin', 'Administrador', 'Psicólogo', 'Capturista'
  descripcion text
  activo boolean [default: true]
}

Table usuarios {
  id serial [pk]
  username varchar [unique, not null]
  password_hash varchar [not null] // Nunca guardar en texto plano
  nombre_completo varchar [not null]
  correo varchar [unique, not null]
  rol_id int [not null]
  ultimo_acceso timestamp
  
  // Campos de auditoría interna
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  is_active boolean [default: true]
}

// ==========================================
// 7. RELACIONES (Foreign Keys)
// ==========================================

// Relaciones Agresor -> Catálogos Simples
Ref: agresor.estado_civil_id > estadocivil.id
Ref: agresor.situacion_academica_id > situacionacademica.id
Ref: agresor.situacion_laboral_id > situacionlaboral.id
Ref: agresor.situacion_vivienda_id > situacionvivienda.id
Ref: agresor.rango_salarial_id > rangosalarial.id
Ref: agresor.religion_id > religion.id
Ref: agresor.relacion_hijos_id > relacionhijos.id

// Relaciones Pivote -> Adicciones
Ref: agresor_adiccion.agresor_folio > agresor.folio
Ref: agresor_adiccion.adiccion_id > adiccion.id

// Relaciones Pivote -> Violencia Infantil
Ref: agresor_violenciainfantil.agresor_folio > agresor.folio
Ref: agresor_violenciainfantil.tipo_violencia_id > tipoviolenciainfantil.id

// Relaciones Pivote -> Relaciones Familiares
Ref: agresor_relacionpadre.agresor_folio > agresor.folio
Ref: agresor_relacionpadre.tipo_relacion_id > tiporelacion.id

Ref: agresor_relacionmadre.agresor_folio > agresor.folio
Ref: agresor_relacionmadre.tipo_relacion_id > tiporelacion.id

Ref: agresor_relacionhermanos.agresor_folio > agresor.folio
Ref: agresor_relacionhermanos.tipo_relacion_id > tiporelacion.id

// Relaciones Pivote -> Entorno Social
Ref: agresor_sectorsocial.agresor_folio > agresor.folio
Ref: agresor_sectorsocial.sector_social_id > sectorsocial.id

Ref: agresor_actividadrecreativa.agresor_folio > agresor.folio
Ref: agresor_actividadrecreativa.actividad_id > actividadrecreativa.id

Ref: agresor_generomusical.agresor_folio > agresor.folio
Ref: agresor_generomusical.genero_id > generomusical.id

// Relaciones Proceso de Reeducación
Ref: procesoreeducacion.agresor_id > agresor.folio
Ref: procesoreeducacion.motivo_ingreso_id > motivoingreso.id
Ref: procesoreeducacion.tipo_violencia_id > tipoviolencia.id
Ref: procesoreeducacion.modalidad_violencia_id > modalidadviolencia.id

// Relaciones Lista (Asistencia)
Ref: lista.agresor_id > agresor.folio
Ref: lista.grupo_id > grupo.folio
Ref: lista.sesion_id > sesion.folio

// Relación de Rol
Ref: usuarios.rol_id > roles.id

// ==========================================
// 8. RELACIONES DE AUDITORÍA (Trazabilidad de Usuarios)
// ==========================================

// --- Entidades Principales y Procesos ---
Ref: agresor.created_by > usuarios.id
Ref: agresor.updated_by > usuarios.id
Ref: agresor.deleted_by > usuarios.id

Ref: procesoreeducacion.created_by > usuarios.id
Ref: procesoreeducacion.updated_by > usuarios.id
Ref: procesoreeducacion.deleted_by > usuarios.id

Ref: grupo.created_by > usuarios.id
Ref: grupo.updated_by > usuarios.id
Ref: grupo.deleted_by > usuarios.id

Ref: sesion.created_by > usuarios.id
Ref: sesion.updated_by > usuarios.id
Ref: sesion.deleted_by > usuarios.id

Ref: lista.created_by > usuarios.id
Ref: lista.updated_by > usuarios.id
Ref: lista.deleted_by > usuarios.id

// --- Catálogos (Select Simple) ---
Ref: estadocivil.created_by > usuarios.id
Ref: estadocivil.updated_by > usuarios.id
Ref: estadocivil.deleted_by > usuarios.id

Ref: situacionacademica.created_by > usuarios.id
