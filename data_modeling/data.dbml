// ==========================================
// 1. TABLAS CATÁLOGO (Select Simple)
// ==========================================

Table estadocivil {
  id serial [pk]
  nombre varchar [unique, not null]
  activo boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

Table relacionhijos {
  id serial [pk]
  nombre varchar [unique, not null]
  activo boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

Table situacionacademica {
  id serial [pk]
  nombre varchar [unique, not null]
  activo boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

Table situacionlaboral {
  id serial [pk]
  nombre varchar [unique, not null]
  activo boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

Table situacionvivienda {
  id serial [pk]
  nombre varchar [unique, not null]
  activo boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

Table rangosalarial {
  id serial [pk]
  nombre varchar [unique, not null]
  activo boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

Table religion {
  id serial [pk]
  nombre varchar [unique, not null]
  activo boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

