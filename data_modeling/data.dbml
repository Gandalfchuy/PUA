// ==========================================
// 3. ENTIDAD PRINCIPAL: AGRESOR
// ==========================================

Table agresor {
  folio serial [pk]
  curp varchar [unique, not null]
  nombre varchar [not null]
  apellido_paterno varchar [not null]
  apellido_materno varchar [not null]
  edad int [not null]
  
  lugar_nacimiento geography
  lugar_residencia geography
  lugar_trabajo geography
  
  parejas_previas int [not null]
  hijos int [not null]
  hermanos int [not null]
  
  estado_civil_id int
  situacion_academica_id int
  situacion_laboral_id int
  situacion_vivienda_id int
  rango_salarial_id int
  religion_id int
  relacion_hijos_id int
  
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

// ==========================================
// 4. TABLAS INTERMEDIAS (Muchos a Muchos)
// ==========================================

Table agresor_adiccion {
  agresor_folio int [pk]
  adiccion_id int [pk]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  created_by int
  updated_by int
  deleted_at timestamp
  deleted_by int
  is_deleted boolean [default: false]
}

Table agresor_violenciainfantil {
